# ============================================================================
# ArchForge — server environment TEMPLATE
# Copy to .env and fill in at least ONE provider key. All are free-tier.
#   cp server/.env.example server/.env
# NOTE: put real keys ONLY in .env (gitignored). This file is committed —
# never place a real secret here.
# ============================================================================

# ── Reasoning: primary (FREE, fast) ─────────────────────────────
# https://console.groq.com/keys   model: llama-3.3-70b-versatile
GROQ_API_KEY=
# Add as many extra Groq keys as you like — GROQ_API_KEY2, GROQ_API_KEY3, …
# All are rotated round-robin. This multiplies the per-MINUTE rate limit.
# For more DAILY tokens, the extra keys must be on SEPARATE Groq accounts
# (the 100k/day budget is per-account), or add a Cerebras key below.
GROQ_API_KEY2=

# ── Reasoning: fallback #1 (FREE, generous daily budget, very fast) ──
# https://cloud.cerebras.ai   model: llama-3.3-70b   (keys start with csk-)
CEREBRAS_API_KEY=

# ── Reasoning: fallback #2 (FREE) ───────────────────────────────
# https://aistudio.google.com/apikey   model: gemini-flash-latest
# Extra keys rotate too: GEMINI_API_KEY2, GEMINI_API_KEY3, …
GEMINI_API_KEY=

# ── High-accuracy mode (OPTIONAL, paid) ─────────────────────────
# https://console.anthropic.com   model: claude-haiku-4-5 / claude-sonnet-5
ANTHROPIC_API_KEY=

# ── Server ──────────────────────────────────────────────────────
PORT=8799
PROVIDER_ORDER=groq,cerebras,gemini,anthropic
# 1 is the measured optimum: a second candidate costs 2x tokens for ~0
# accuracy gain once the verifier has normalized both (see src/dev/ablation.js).
CANDIDATES=1
